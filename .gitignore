# Build artifacts
dist/
dist-generator/
# Generated by `make dist-zip` / `make sbom` / the drift gate; the release
# publishes them as assets rather than committing them. Anchored, so a fixture
# with one of these names under samples/ is still tracked.
/blitsbom-*.zip
/blitsbom-*.sha512
/blitsbom-*.sigstore
/blitsbom-*-sbom.cdx.json
/blitsbom-*-sbom-report.html
/drift-check.cdx.json
/drift-check.html
# Names used before #222, kept so a tree that predates the rename stays clean.
# Removable once no working copy carries them, alongside the matching `clean`
# line in the Makefile.
dist.zip
/dist.zip.cdx.json
/dist.zip.cdx.html
.vite/

