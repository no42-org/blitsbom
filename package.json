{
  "name": "blitsbom",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "license": "MIT",
  "description": "Zero-install CycloneDX SBOM viewer — runs in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"*.{json,md,html}\"",
    "size-check": "node scripts/size-check.mjs",
    "purity-check": "node scripts/purity-check.mjs",
    "smoke": "node scripts/file-smoke.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^25.9.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.9"
  }
}
