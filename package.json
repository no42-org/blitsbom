{
  "name": "blitsbom",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "description": "Zero-install CycloneDX SBOM viewer — runs in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:generator": "vite build --config vite.config.generator.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"*.{json,md,html}\"",
    "size-check": "node scripts/size-check.mjs",
    "purity-check": "node scripts/purity-check.mjs",
    "smoke": "node scripts/file-smoke.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.1.1",
    "autoprefixer": "^10.5.2",
    "fast-check": "4.9.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.15",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
