{
  "name": "blitsbom",
  "private": true,
  "version": "0.8.4",
  "type": "module",
  "license": "MIT",
  "description": "Zero-install CycloneDX and SPDX SBOM viewer — runs in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:generator": "vite build --config vite.config.generator.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"*.{json,md,html}\"",
    "size-check": "node scripts/size-check.mjs",
    "purity-check": "node scripts/purity-check.mjs",
    "marketplace-check": "node scripts/marketplace-check.mjs",
    "smoke": "node scripts/file-smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "license-table": "node scripts/scancode-categories.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.6.1",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
